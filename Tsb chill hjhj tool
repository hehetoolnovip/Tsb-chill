-- ============ BƯỚC 7: AUTO LOCK ============
task.spawn(function()
    while task.wait(0.03) do
        if State.LockEnabled then
            local myChar = LocalPlayer.Character
            local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
            if myHRP then
                local target = State.CurrentTarget
                if target then
                    local tHum = target.Character and target.Character:FindFirstChildOfClass("Humanoid")
                    local tHRP = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
                    if not tHum or tHum.Health <= 0 or not tHRP then
                        State.CurrentTarget = nil
                    end
                end
                if not State.CurrentTarget then
                    local entry = pickTarget()
                    if entry then State.CurrentTarget = entry.Player end
                end
                if State.CurrentTarget and State.CurrentTarget.Character then
                    local tHRP = State.CurrentTarget.Character:FindFirstChild("HumanoidRootPart")
                    if tHRP then
                        local targetLook = tHRP.CFrame.LookVector
                        local behindPos = tHRP.Position - targetLook * State.LockOffset + Vector3.new(0, State.LockHeight, 0)
                        local goalCFrame = CFrame.new(behindPos, tHRP.Position + targetLook * 10)
                        local currentCFrame = myHRP.CFrame
                        local dist = (goalCFrame.Position - currentCFrame.Position).Magnitude
                        local alpha = math.clamp(State.LockSmooth * (1 + dist * 0.1), 0.05, 0.9)
                        myHRP.CFrame = currentCFrame:Lerp(goalCFrame, alpha)
                    end
                end
            end
        end
        if State.CameraLock and State.CurrentTarget and State.CurrentTarget.Character then
            local tHRP = State.CurrentTarget.Character:FindFirstChild("HumanoidRootPart")
            if tHRP and workspace.CurrentCamera then
                workspace.CurrentCamera.CFrame = CFrame.new(workspace.CurrentCamera.CFrame.Position, tHRP.Position)
            end
        end
    end
end)

