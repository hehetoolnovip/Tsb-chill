                end

                -- Strip tools
                if State.AutoStripTools then stripTools(plr) end

                -- Remove accessories
                if State.AutoRemoveAccessories then removeAccessories(plr) end

                -- Damage
                if State.AutoDamageAll and hum and hum.Health > 0 then
                    hum.Health = math.max(0, hum.Health - State.DamageAmount)
                end

                -- Burn
                if State.AutoBurnAll then burnPlayer(plr) end

                -- Invisible others
                if State.AutoInvisibleOthers then
                    for _, part in ipairs(char:GetDescendants()) do
                        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                            part.Transparency = 1
                        end
                    end
                end

                -- Slow
                if State.AutoSlowAll and hum then hum.WalkSpeed = State.SlowValue end

                -- Void
                if State.AutoVoidAll and hrp then
                    hrp.CFrame = CFrame.new(hrp.Position.X, -500, hrp.Position.Z)
                end

                -- Size
                if State.AutoSizeAll then
                    for _, part in ipairs(char:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.Size = Vector3.new(State.SizeValue, State.SizeValue, State.SizeValue)
                        end
                    end
                end

                -- Transparency
                if State.AutoTransparencyAll then
                    for _, part in ipairs(char:GetDescendants()) do
                        if part:IsA("BasePart") then part.Transparency = 0.7 end
                    end
                end

                -- Color
                if State.AutoColorAll then
                    for _, part in ipairs(char:GetDescendants()) do
                        if part:IsA("BasePart") then part.Color = Color3.fromRGB(255, 0, 0) end
                    end
                end

                -- Gravity (BodyForce)
                if State.AutoGravityAll and hrp then
                    if not hrp:FindFirstChild("GriefGravity") then
                        local bf = Instance.new("BodyForce")
                        bf.Name = "GriefGravity"
                        bf.Force = Vector3.new(0, State.GravityValue * 1000, 0)
                        bf.Parent = hrp
                    end
                end

                -- Speed
                if State.AutoSpeedAll and hum then hum.WalkSpeed = State.SpeedValueAll end

                -- Health
                if State.AutoHealthAll and hum then hum.Health = State.HealthValueAll end

                -- NoClip
                if State.AutoNoClipAll then
                    for _, part in ipairs(char:GetDescendants()) do
                        if part:IsA("BasePart") then part.CanCollide = false end
                    end
                end

                -- Anchor
                if State.AutoAnchorAll and hrp then hrp.Anchored = true end

