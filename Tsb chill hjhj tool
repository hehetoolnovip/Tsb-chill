-- ============ BƯỚC 2: HÀM ẨN BẢN THÂN ============
local function applyHideSelf(character)
    if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
        humanoid.NameDisplayDistance = 0
        humanoid.HealthDisplayDistance = 0
        humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
    end
    for _, obj in ipairs(character:GetDescendants()) do
        if obj:IsA("BasePart") then
            obj.CanCollide = false
            obj.CanQuery = false
            obj.CanTouch = false
            obj.Transparency = 1
            obj.Massless = true
            obj.Size = Vector3.new(0.1, 0.1, 0.1)
        elseif obj:IsA("BillboardGui") then
            obj:Destroy()
        elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam")
            or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") or obj:IsA("Highlight") then
            obj.Enabled = false
        elseif obj:IsA("Decal") or obj:IsA("Texture") then
            obj.Transparency = 1
        elseif obj:IsA("TextLabel") or obj:IsA("Frame") or obj:IsA("ImageLabel") then
            local n = obj.Name:lower()
            if n:find("name") or n:find("health") or n:find("hp") or n:find("bar") or n:find("tag") then
                obj.Visible = false
                obj:Destroy()
            end
        end
    end
end

local function restoreHideSelf(character)
    if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
        humanoid.NameDisplayDistance = 100
        humanoid.HealthDisplayDistance = 100
        humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOn
    end
    for _, obj in ipairs(character:GetDescendants()) do
        if obj:IsA("BasePart") then
            obj.Transparency = 0
            obj.Massless = false
            if obj.Name == "HumanoidRootPart" then obj.Size = Vector3.new(2, 2, 1)
            elseif obj.Name == "Head" then obj.Size = Vector3.new(2, 1, 1)
            elseif obj.Name == "Torso" or obj.Name == "UpperTorso" then obj.Size = Vector3.new(2, 2, 1)
            elseif obj.Name == "LowerTorso" then obj.Size = Vector3.new(2, 1, 1) end
        end
    end
end

-- ============ BƯỚC 3: CHỌN MỤC TIÊU ============
local function getAlivePlayers()
    local list = {}
    local myChar = LocalPlayer.Character
    if not myChar then return list end
    local myHRP = myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return list end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            if hum and hrp and hum.Health > 0 then
                table.insert(list, {Player = plr, Humanoid = hum, HRP = hrp})
            end
        end
    end
    return list
end

local function pickTarget()
    local list = getAlivePlayers()
    if #list == 0 then return nil end
    local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myHRP then return nil end
    if State.LockMode == "Nearest" then
        local best, bestDist = nil, math.huge
        for _, e in ipairs(list) do
            local d = (e.HRP.Position - myHRP.Position).Magnitude
            if d < bestDist then best, bestDist = e, d end
        end
        return best
    elseif State.LockMode == "LowestHP" then
        local best = nil
        for _, e in ipairs(list) do
            if not best or e.Humanoid.Health < best.Humanoid.Health then best = e end
        end
        return best
    elseif State.LockMode == "Random" then
        return list[math.random(1, #list)]
    end
    return list[1]
end

-- ============ BƯỚC 4: HÀM XỬ LÝ CHÍNH (FIX HOẠT ĐỘNG) ============

-- Đóng băng người chơi khác (client-side)
local function freezePlayer(plr)
    if not plr or plr == LocalPlayer or not plr.Character then return end
    local hum = plr.Character:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.WalkSpeed = 0
        hum.JumpPower = 0
        hum.PlatformStand = true
        -- Xóa mọi BodyMover để không bị đẩy
        for _, obj in ipairs(plr.Character:GetDescendants()) do
            if obj:IsA("BodyMover") or obj:IsA("BodyVelocity") or obj:IsA("BodyGyro") or obj:IsA("BodyForce") then
                obj:Destroy()
            end
        end
    end
end

-- Đóng băng NPC
local function freezeNPC(npc)
    if not npc then return end
    local hum = npc:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.WalkSpeed = 0
        hum.JumpPower = 0
        hum.PlatformStand = true
    end
end

-- Kill người chơi khác (client-side - có thể không hiệu quả nếu server bảo vệ)
local function killPlayer(plr)
    if not plr or plr == LocalPlayer or not plr.Character then return end
    local hum = plr.Character:FindFirstChildOfClass("Humanoid")
    if hum then hum.Health = 0 end
end

-- Fling người chơi (đẩy bay)
local function flingPlayer(plr, power)
    if not plr or plr == LocalPlayer or not plr.Character then return end
    local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
    if hrp then
        local old = hrp:FindFirstChild("GriefFling")
        if old then old:Destroy() end
        local bv = Instance.new("BodyVelocity")
        bv.Name = "GriefFling"
        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bv.Velocity = Vector3.new(
            math.random(-power, power),
            power,
            math.random(-power, power)
        )
        bv.Parent = hrp
    end
end

-- Tước vũ khí
local function stripTools(plr)
    if not plr or plr == LocalPlayer or not plr.Character then return end
    for _, tool in ipairs(plr.Character:GetChildren()) do
        if tool:IsA("Tool") then tool:Destroy() end
    end
    local backpack = plr:FindFirstChildOfClass("Backpack")
    if backpack then
        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") then tool:Destroy() end
        end
    end
end

-- Xóa phụ kiện
local function removeAccessories(plr)
    if not plr or plr == LocalPlayer or not plr.Character then return end
    for _, acc in ipairs(plr.Character:GetChildren()) do
        if acc:IsA("Accessory") or acc:IsA("Hat") then acc:Destroy() end
    end
end

-- Đốt cháy
local function burnPlayer(plr)
    if not plr or plr == LocalPlayer or not plr.Character then return end
    local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
    if hrp and not hrp:FindFirstChild("GriefFire") then
        local f = Instance.new("Fire")
        f.Name = "GriefFire"
        f.Size = 15
        f.Heat = 50
        f.Parent = hrp
    end
end

-- Làm mù
local function blindPlayer(plr)
    if not plr or plr == LocalPlayer or not plr.Character then return end
    local head = plr.Character:FindFirstChild("Head")
    if head and not head:FindFirstChild("GriefBlind") then
        local sg = Instance.new("BillboardGui")
        sg.Name = "GriefBlind"
        sg.Size = UDim2.new(100, 0, 100, 0)
        sg.AlwaysOnTop = true
        sg.Adornee = head
        sg.Parent = head
        local f = Instance.new("Frame")
        f.Size = UDim2.new(1, 0, 1, 0)
        f.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        f.BackgroundTransparency = 0.3
        f.Parent = sg
    end
end

